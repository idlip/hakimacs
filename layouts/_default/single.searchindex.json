{{- /* Search index: one entry per sentence across all RegularPages. */ -}}
{{- $items := slice -}}
{{- range site.RegularPages -}}
  {{- $title := .Title -}}
  {{- $url := .RelPermalink -}}
  {{- $plain := .Plain | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace -}}
  {{- $sep := printf "%c" 1 -}}
  {{- $marked := $plain | replaceRE `([.!?])\s+` (printf "$1%s" $sep) -}}
  {{- range split $marked $sep -}}
    {{- $text := strings.TrimSpace . -}}
    {{- if gt (len $text) 3 -}}
      {{- /* No tokens array (decision 19's polish cut, synced from
        denden-search-index-json, 2026-09-17/18 session): the client
        (search.js) matches words against :text directly. */ -}}
      {{- $items = $items | append (dict "title" $title "url" $url "text" $text) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ $items | jsonify }}
